        borderRadius: 12,
        padding: '1.25rem 1rem 1rem',
        display: 'flex',
        flexDirection: 'column',
        gap: 10,
        transition: 'border-color 0.2s, transform 0.15s',
        transform: hovered ? 'translateY(-2px)' : 'none',
      }}
    >
      {broker.featured && (
        <span style={{
          position: 'absolute', top: -1, right: 12,
